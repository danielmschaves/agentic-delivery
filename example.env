# Copy to .env (gitignored). Only variables for adapters you enable are needed.
# Atlassian (Jira / Confluence)
ATLASSIAN_SITE=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
# Azure DevOps
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
# Microsoft 365 (Graph)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Google Workspace (service account JSON path) — optional, MCP connectors cover interactive use
GOOGLE_APPLICATION_CREDENTIALS=
