[project]
name = "{{ project_key | lower }}-delivery-hub"
version = "0.0.0"
description = "Delivery hub for {{ project_name }}"
requires-python = ">=3.12"
dependencies = [
    # Hub tooling (`ad` CLI). Bump the tag to upgrade; template files upgrade via `copier update`.
    "agentic-delivery @ {{ tooling_source }}",
]

[dependency-groups]
dev = ["pre-commit>=4.7.0"]

[tool.uv]
package = false
